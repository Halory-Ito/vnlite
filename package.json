{
  "name": "vnlite",
  "version": "1.4.4",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "smoke:api": "bun run scripts/smoke-api.ts",
    "smoke:db": "bun run scripts/smoke-db.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run smoke:api && bun run smoke:theme && bun run smoke:layout && bun run smoke:db",
    "bundle:check": "expo export --platform android --output-dir .tmp-export",
    "build:android": "npm_config_registry=https://registry.npmjs.org bunx eas-cli build --platform android --profile preview",
    "build:android:arm64": "npm_config_registry=https://registry.npmjs.org bunx eas-cli build --platform android --profile preview-arm64",
    "build:android:dev": "npm_config_registry=https://registry.npmjs.org bunx eas-cli build --platform android --profile development",
    "build:android:prod": "npm_config_registry=https://registry.npmjs.org bunx eas-cli build --platform android --profile production",
    "build:ios": "npm_config_registry=https://registry.npmjs.org bunx eas-cli build --platform ios --profile preview",
    "build:ios:sim": "npm_config_registry=https://registry.npmjs.org bunx eas-cli build --platform ios --profile preview-simulator",
    "smoke:theme": "bun run scripts/smoke-theme.ts",
    "smoke:layout": "bun run scripts/smoke-layout.ts",
    "sync:kungal": "bun run scripts/sync-kungal-logos.ts",
    "sync:awards": "bun run scripts/sync-awards.ts",
    "sync:awards-csv": "bun run scripts/sync-awards-csv.ts",
    "sync:getchu-awards": "bun run scripts/sync-getchu-awards.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.104.0",
    "expo": "^58.0.0",
    "expo-blur": "58.0.5",
    "expo-calendar": "~58.0.6",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-intent-launcher": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-notifications": "^58.1.7",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sensors": "~58.0.4",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "heroui-native": "^1.0.10",
    "i18n-js": "^4.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-chart-kit": "^7.0.4",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.13.0",
    "react-native-zoom-toolkit": "^5.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.2",
    "toqr": "0.1.1",
    "uniwind": "^1.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.15",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "~6.0.3"
  }
}
